{
  "name": "workinfoneu",
  "version": "1.0.0",
  "description": "工作日志桌面应用（Neutralinojs 版）：日历视图 + 18:00 工作日提醒 + 本地持久化 + 导出",
  "private": true,
  "scripts": {
    "build:web": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "npm run build:web && neu run",
    "build": "npm run build:web && neu build",
    "build:release": "npm run build:web && neu build --release",
    "build:win": "npm run build:release --embed-resources",
    "run": "npm run build:web && neu run"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.10"
  }
}